generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Promoteur {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String
  createdAt DateTime @default(now())
}

model Participant {
  id          String     @id @default(cuid())
  prenom      String
  age         Int
  instagram   String
  telephone   String?
  email       String?
  statut      String     @default("EN_ATTENTE")
  manychatId  String?
  source      String     @default("Instagram DM")
  notes       String?
  evenementId String?
  evenement   Evenement? @relation(fields: [evenementId], references: [id])
  createdAt   DateTime   @default(now())
}

model Evenement {
  id              String           @id @default(cuid())
  nom             String
  date            DateTime
  lieu            String
  adresse         String
  heureDebut      String
  heureFin        String
  dressCode       String?
  maxParticipants Int              @default(50)
  statut          String           @default("PLANIFIE")
  participants    Participant[]
  staffAssignes   StaffEvenement[]
  createdAt       DateTime         @default(now())
}

model Staff {
  id         String           @id @default(cuid())
  prenom     String
  nom        String
  telegramId String?
  whatsapp   String?
  email      String?
  role       String
  fiabilite  Int              @default(5)
  evenements StaffEvenement[]
  createdAt  DateTime         @default(now())
}

model StaffEvenement {
  id          String    @id @default(cuid())
  staffId     String
  evenementId String
  statut      String    @default("EN_ATTENTE")
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)

  @@unique([staffId, evenementId])
}

model Contenu {
  id           String    @id @default(cuid())
  restaurant   String
  scoreGlobal  Float     @default(0)
  scoreViral   Float     @default(0)
  scoreLuxe    Float     @default(0)
  slides       String
  caption      String?
  hashtags     String?
  statut       String    @default("EN_ATTENTE")
  instagramUrl String?
  tiktokUrl    String?
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?
}
