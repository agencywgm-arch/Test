# =============================================================
# NIGHTLIFE PARIS — VARIABLES D'ENVIRONNEMENT
# Copier ce fichier en .env et remplir toutes les valeurs
# NE JAMAIS committer le fichier .env dans git
# =============================================================

# -------------------------------------------------------------
# TELEGRAM
# -------------------------------------------------------------
# Token du bot créé via @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID du promoteur (envoyer /start au bot, puis appeler
# https://api.telegram.org/bot{TOKEN}/getUpdates pour trouver l'ID)
TELEGRAM_PROMOTEUR_CHAT_ID=

# ID du groupe Telegram staff (optionnel — pour les messages collectifs)
TELEGRAM_STAFF_GROUP_ID=

# URL publique du webhook Telegram (configurée via setWebhook)
# Format: https://VOTRE-N8N.railway.app/webhook/telegram-webhook
TELEGRAM_WEBHOOK_URL=

# -------------------------------------------------------------
# GOOGLE SHEETS
# -------------------------------------------------------------
# ID du Google Sheets (dans l'URL : .../spreadsheets/d/SPREADSHEET_ID/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Email du compte de service Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clé privée du compte de service (inclure les \n)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# -------------------------------------------------------------
# GEMINI (Google AI)
# -------------------------------------------------------------
# Clé API depuis https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modèle à utiliser (gemini-1.5-flash est le plus économique)
GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------------------------
# APIFY
# -------------------------------------------------------------
# Token API depuis https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# -------------------------------------------------------------
# MANYCHAT
# -------------------------------------------------------------
# Token API depuis ManyChat → Settings → API
MANYCHAT_API_TOKEN=

# ID de la page Facebook connectée à ManyChat
MANYCHAT_PAGE_ID=

# -------------------------------------------------------------
# INSTAGRAM / META
# -------------------------------------------------------------
# ID du compte Instagram Business
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Token d'accès Instagram (longue durée, valide 60 jours)
# Obtenir via Meta for Developers → Graph API Explorer
INSTAGRAM_ACCESS_TOKEN=

# Version de l'API Graph Meta
INSTAGRAM_API_VERSION=v18.0

# -------------------------------------------------------------
# N8N (AUTO-HÉBERGÉ)
# -------------------------------------------------------------
# URL publique de votre instance n8n sur Railway
N8N_WEBHOOK_BASE_URL=https://VOTRE-PROJET.railway.app

# Clé de chiffrement n8n (générer avec: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# Identifiants de connexion à l'interface n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Base de données n8n (SQLite par défaut sur Railway)
DB_TYPE=sqlite
DB_SQLITE_DATABASE=/home/node/.n8n/database.sqlite

# -------------------------------------------------------------
# RAILWAY (optionnel — pour référence)
# -------------------------------------------------------------
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT=production
