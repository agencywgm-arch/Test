FROM n8nio/n8n:latest

USER root

# Dépendances pour Chromium (utile si puppeteer est utilisé dans des workflows)
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

# Configurer Chromium pour Puppeteer
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

USER node

# Port exposé par n8n
EXPOSE 5678

# Point d'entrée
CMD ["n8n", "start"]
