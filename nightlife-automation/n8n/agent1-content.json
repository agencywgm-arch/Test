{
  "name": "Agent 1 — Content Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "a1-trigger",
      "name": "Déclencheur quotidien 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/compass~crawler-google-places/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $env.APIFY_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "searchStringsArray",
              "value": "[\"restaurants tendance Paris\", \"rooftop bar Paris\", \"restaurant gastronomique Paris\"]"
            },
            {
              "name": "language",
              "value": "fr"
            },
            {
              "name": "maxCrawledPlaces",
              "value": "20"
            },
            {
              "name": "includeImages",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "a1-apify-run",
      "name": "Apify — Lancer scrape restaurants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "wait",
        "unit": "minutes",
        "amount": 3
      },
      "id": "a1-wait-apify",
      "name": "Attendre résultats Apify (3 min)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.apify.com/v2/acts/compass~crawler-google-places/runs/last/dataset/items?token={{ $env.APIFY_API_TOKEN }}&limit=20",
        "options": {}
      },
      "id": "a1-apify-results",
      "name": "Apify — Récupérer résultats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst restaurants = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data.title || !data.description) continue;\n\n  restaurants.push({\n    id: data.placeId || data.id,\n    nom: data.title,\n    description: data.description || data.categoryName || '',\n    adresse: data.address || '',\n    note: data.totalScore || 0,\n    nbAvis: data.reviewsCount || 0,\n    instagram: data.website || '',\n    photos: (data.imageUrls || []).slice(0, 8),\n    ambiance: data.categoryName || 'Restaurant',\n    cuisine: data.categories ? data.categories.join(', ') : ''\n  });\n}\n\n// Garder top 5 restaurants par note\nrestaurants.sort((a, b) => b.note - a.note);\nconst top5 = restaurants.slice(0, 5);\n\nreturn top5.map(r => ({ json: r }));"
      },
      "id": "a1-parse",
      "name": "Parser résultats Apify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "=[{\"parts\": [{\"text\": \"Tu es un expert en marketing lifestyle et nightlife parisien. Analyse ce restaurant et génère un contenu Instagram carrousel percutant pour attirer un public féminin 18-30 ans CSP+.\\n\\nRESTAURANT :\\nNom: {{ $json.nom }}\\nDescription: {{ $json.description }}\\nAmbiance: {{ $json.ambiance }}\\nCuisine: {{ $json.cuisine }}\\nNote: {{ $json.note }}/5 ({{ $json.nbAvis }} avis)\\nAdresse: {{ $json.adresse }}\\n\\nGénère un JSON avec cette structure exacte :\\n{\\n  \\\"score_viral\\\": [0-10],\\n  \\\"score_luxe\\\": [0-10],\\n  \\\"score_feminin\\\": [0-10],\\n  \\\"score_lifestyle\\\": [0-10],\\n  \\\"score_global\\\": [0-10],\\n  \\\"slides\\\": [\\n    {\\\"titre\\\": \\\"[titre court percutant 3-5 mots]\\\", \\\"phrase\\\": \\\"[phrase émotionnelle 10-15 mots]\\\"},\\n    {\\\"titre\\\": \\\"[titre slide 2]\\\", \\\"phrase\\\": \\\"[phrase émotionnelle slide 2]\\\"},\\n    {\\\"titre\\\": \\\"[titre slide 3]\\\", \\\"phrase\\\": \\\"[phrase émotionnelle slide 3]\\\"},\\n    {\\\"titre\\\": \\\"[titre slide 4]\\\", \\\"phrase\\\": \\\"[phrase émotionnelle slide 4]\\\"},\\n    {\\\"titre\\\": \\\"Pour rejoindre nos prochains dîners privés\\\", \\\"phrase\\\": \\\"Envoyez-nous un message pour participer gratuitement à nos prochains restaurants et événements privés.\\\"}\\n  ],\\n  \\\"hashtags\\\": [\\\"#paris\\\", \\\"#nightlifeparis\\\", \\\"...\\\"],\\n  \\\"caption_instagram\\\": \\\"[caption complet avec emojis et hashtags]\\\"\\n}\\n\\nRéponds uniquement avec le JSON, sans markdown.\"}]}]"
            }
          ]
        },
        "options": {}
      },
      "id": "a1-gemini-content",
      "name": "Gemini — Générer contenu carrousel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "jsCode": "const restaurantData = $('Parser résultats Apify').item.json;\nconst geminiResponse = $input.item.json;\n\nlet contentText = '';\ntry {\n  contentText = geminiResponse.candidates[0].content.parts[0].text;\n  // Nettoyer le JSON si entouré de backticks\n  contentText = contentText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n} catch(e) {\n  contentText = '{}';\n}\n\nlet content = {};\ntry {\n  content = JSON.parse(contentText);\n} catch(e) {\n  content = {\n    score_global: 5,\n    slides: [{titre: restaurantData.nom, phrase: restaurantData.description}],\n    hashtags: ['#paris', '#nightlifeparis'],\n    caption_instagram: restaurantData.description\n  };\n}\n\nreturn [{\n  json: {\n    restaurant: restaurantData,\n    content: content,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "a1-parse-gemini",
      "name": "Parser réponse Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.content.score_global }}",
              "operation": "largerEqual",
              "value2": 6
            }
          ]
        }
      },
      "id": "a1-score-filter",
      "name": "Score ≥ 6 ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_PROMOTEUR_CHAT_ID }}",
        "text": "=🍽️ *NOUVEAU CONTENU À VALIDER*\n\n*{{ $json.restaurant.nom }}*\n📍 {{ $json.restaurant.adresse }}\n⭐ {{ $json.restaurant.note }}/5 · {{ $json.restaurant.nbAvis }} avis\n\n📊 *Scores IA :*\n• Viral : {{ $json.content.score_viral }}/10\n• Luxe : {{ $json.content.score_luxe }}/10\n• Féminin : {{ $json.content.score_feminin }}/10\n• Lifestyle : {{ $json.content.score_lifestyle }}/10\n• *Global : {{ $json.content.score_global }}/10*\n\n📝 *Slides prévus :*\n{{ $json.content.slides.map((s, i) => `${i+1}. **${s.titre}**\\n_${s.phrase}_`).join('\\n\\n') }}\n\n🏷️ {{ $json.content.hashtags.join(' ') }}\n\n_Validez pour publier sur Instagram + TikTok_",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": "={\"inline_keyboard\": [[{\"text\": \"✅ Valider et publier\", \"callback_data\": \"agent1_valider_{{ $json.restaurant.id }}\"}, {\"text\": \"❌ Refuser\", \"callback_data\": \"agent1_refuser_{{ $json.restaurant.id }}\"}], [{\"text\": \"ℹ️ Plus d'infos\", \"callback_data\": \"agent1_info_{{ $json.restaurant.id }}\"}]]}"
        }
      },
      "id": "a1-telegram-preview",
      "name": "Telegram — Envoyer preview promoteur",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [2000, 200],
      "credentials": {
        "telegramApi": {
          "id": "telegram-creds",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}"
        },
        "sheetName": "Contenu publié",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Restaurant": "={{ $json.restaurant.nom }}",
            "Date création": "={{ new Date().toLocaleDateString('fr-FR') }}",
            "Statut validation": "EN ATTENTE",
            "Score global": "={{ $json.content.score_global }}",
            "Instagram URL": "",
            "TikTok URL": "",
            "Caption": "={{ $json.content.caption_instagram }}"
          }
        }
      },
      "id": "a1-sheets-log",
      "name": "Google Sheets — Logger contenu",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [2000, 420],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "sheets-creds",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "path": "agent1-decision",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "a1-webhook-decision",
      "name": "Webhook — Décision promoteur",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [2220, 300],
      "webhookId": "agent1-decision"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.decision }}",
              "operation": "equals",
              "value2": "valider"
            }
          ]
        }
      },
      "id": "a1-if-valider",
      "name": "Décision : Valider ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.INSTAGRAM_BUSINESS_ACCOUNT_ID }}/media",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $('Parser réponse Gemini').item.json.restaurant.photos[0] }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Parser réponse Gemini').item.json.content.caption_instagram }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1-instagram-publish",
      "name": "Instagram — Publier carrousel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2660, 200]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "value": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}"
        },
        "sheetName": "Contenu publié",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Statut validation": "PUBLIÉ",
            "Date publication": "={{ new Date().toLocaleDateString('fr-FR') }}"
          }
        }
      },
      "id": "a1-sheets-update",
      "name": "Google Sheets — Mettre à jour statut",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [2880, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "sheets-creds",
          "name": "Google Sheets"
        }
      }
    }
