      "id": "pw-webhook",
      "name": "Webhook — Telegram callback_query",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "telegram-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\n\n// Telegram envoie callback_query pour les boutons inline\nconst callbackQuery = body.callback_query;\nif (!callbackQuery) {\n  return [{ json: { valid: false, error: 'Not a callback_query' } }];\n}\n\nconst data = callbackQuery.data || '';\n// Format: agent1_valider_ID | agent1_refuser_ID | agent1_info_ID\n//         agent2_accepter_ID | agent2_refuser_ID | agent2_info_ID\n//         staff_oui_ID_EVTID | staff_non_ID_EVTID\n\nconst parts = data.split('_');\nconst agent = parts[0];   // agent1, agent2, staff\nconst action = parts[1];  // valider, refuser, accepter, info, oui, non\nconst itemId = parts.slice(2).join('_');\n\nconst chatId = callbackQuery.message?.chat?.id;\nconst messageId = callbackQuery.message?.message_id;\nconst userId = callbackQuery.from?.id;\nconst callbackId = callbackQuery.id;\n\nreturn [{\n  json: {\n    valid: true,\n    agent,\n    action,\n    item_id: itemId,\n    chat_id: chatId,\n    message_id: messageId,\n    user_id: userId,\n    callback_query_id: callbackId,\n    raw: callbackQuery\n  }\n}];"
      },
      "id": "pw-parse",
      "name": "Parser callback_query Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/answerCallbackQuery",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "callback_query_id",
              "value": "={{ $json.callback_query_id }}"
            },
            {
              "name": "text",
              "value": "=✅ Reçu ! Action en cours..."
            }
          ]
        },
        "options": {}
      },
      "id": "pw-ack",
      "name": "Telegram — Acquitter callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "value2": "agent1"
            },
            {
              "value2": "agent2"
            },
            {
              "value2": "staff"
            }
          ]
        },
        "fallbackOutput": "extra"
      },
      "id": "pw-switch",
      "name": "Router par agent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [900, 300]
    },
